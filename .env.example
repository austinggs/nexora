NEXT_PUBLIC_SUPABASE_URL=https://qjhugmzhtecgskzynxin.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only auth/admin secrets
MANUAL_SESSION_SECRET=generate_a_long_random_secret_at_least_32_chars
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Direct Celo payout worker — NEVER expose these as NEXT_PUBLIC_* variables
# Safe default: disabled. Change to live only after Celo has been tested.
CELO_PAYOUT_MODE=disabled
# Ledger amounts are stored as USD cents; the payout worker converts cents to each token's base units.
CELO_NETWORK=mainnet
CELO_RPC_URL=https://your-celo-rpc.example
CELO_PAYOUT_PRIVATE_KEY=0xserver_only_payout_wallet_private_key
# Celo mainnet token contracts (public addresses; verify before production funding)
CELO_USDC_CONTRACT=0xceba9300f2b948710d2653dd7b07f33a8b32118c
CELO_USDT_CONTRACT=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e
CELO_USDM_CONTRACT=0x59d9356e565ab3a36dd77763fc0d87feaf85508c
